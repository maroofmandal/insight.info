{
  "name": "insight-info",
  "description": "Privacy-conscious web and product analytics for clear, actionable insight.",
  "private": true,
  "author": "Insight.info <info@insight.info> (https://insight.info/)",
  "scripts": {
    "build": "turbo run build --filter=!./apps/dev-proxy",
    "dev": "turbo run dev --filter=!./apps/health-check",
    "lint": "turbo run lint",
    "sync:web-sdk": "bun scripts/sync-web-sdk.ts",
    "tsc": "turbo run tsc",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:integration": "turbo run test:integration",
    "e2e": "turbo run e2e --filter=e2e",
    "e2e:ui": "turbo run e2e:ui --filter=e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "turbo": "turbo"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "prettier": "^3.0.3",
    "turbo": "2.6.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.11"
}

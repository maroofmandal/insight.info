{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "INSIGHT_TOKEN",
    "INSIGHT_SITE_URL",
    "INSIGHT_APP_URL",
    "INSIGHT_HUB_URL",
    "INSIGHT_SINGLE_ORIGIN",
    "INSIGHT_FAVICON_API_URL",
    "INSIGHT_TOPO_URL",
    "VEMETRIC_TOKEN",
    "VEMETRIC_SITE_URL",
    "VEMETRIC_APP_URL",
    "VEMETRIC_HUB_URL",
    "VEMETRIC_FAVICON_API_URL",
    "VEMETRIC_TOPO_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^db:generate", "^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "test": {},
    "test:watch": {},
    "test:integration": {},
    "e2e": {
      "cache": false
    },
    "e2e:ui": {
      "cache": false
    },
    "lint": {},
    "tsc": {},
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:deploy:prod": {
      "cache": false
    }
  }
}

---
interface Props { eyebrow: string; title: string; description: string; }
const { eyebrow, title, description } = Astro.props;
---
<header class="page-hero shell"><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p class="lede">{description}</p></header>
<style>.page-hero{padding:100px 0 72px;text-align:center;position:relative}.page-hero::before{content:'';position:absolute;z-index:-1;inset:0 10% 0;background:radial-gradient(circle at 50% 20%,#f0eaff,transparent 64%)}.page-hero h1{max-width:900px;margin:22px auto}.page-hero p{max-width:720px;margin:0 auto}@media(max-width:600px){.page-hero{padding:72px 0 45px}}</style>

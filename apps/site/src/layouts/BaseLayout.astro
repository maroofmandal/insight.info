---
import { BRAND } from '@vemetric/common/brand';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  pageClass?: string;
}

const {
  title = 'Analytics that turns activity into answers',
  description = BRAND.description,
  noindex = false,
  pageClass = '',
} = Astro.props;
const pageTitle = title.includes(BRAND.name) ? title : `${title} | ${BRAND.name}`;
const siteUrl = process.env.INSIGHT_SITE_URL || process.env.VEMETRIC_SITE_URL || BRAND.siteUrl;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#fbfaff" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-insight.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-insight.png`} />
    <title>{pageTitle}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav shell" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Insight.info home"><img src="/logo-lockup.svg" alt="Insight.info" /></a>
        <button class="menu-button" type="button" aria-controls="nav-links" aria-expanded="false"><span></span><span></span><span></span><span class="sr-only">Toggle menu</span></button>
        <div class="nav-links" id="nav-links">
          <a href="/pricing">Pricing</a>
          <a href="/docs">Docs</a>
          <details class="nav-popover">
            <summary>Resources</summary>
            <div><a href="/changelog">Changelog <small>What is new in Insight.info</small></a><a href="/blog">Blog <small>Practical analytics notes</small></a></div>
          </details>
          <details class="nav-popover">
            <summary>Company</summary>
            <div><a href="/about">About <small>Why Insight.info exists</small></a><a href="/customers">Use cases <small>Who the product is built for</small></a><a href="/favicon-api">Favicon API <small>A configurable icon service</small></a></div>
          </details>
        </div>
        <div class="nav-actions"><a class="button small" href="/login">Sign in</a></div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="shell footer-grid">
        <div><a class="brand footer-brand" href="/"><img src="/logo-lockup.svg" alt="Insight.info" /></a><p>{BRAND.description}</p></div>
        <div><strong>Product</strong><a href="/pricing">Pricing</a><a href="/docs/frequently-asked-questions">FAQs</a><a href="/favicon-api">Favicon API</a></div>
        <div><strong>Resources</strong><a href="/docs">Documentation</a><a href="/changelog">Changelog</a><a href="/blog">Blog</a></div>
        <div><strong>Company</strong><a href="/about">About</a><a href="/customers">Use cases</a><a href="mailto:info@insight.info">Contact</a></div>
        <div><strong>Legal</strong><a href="/legal/terms-of-service">Terms</a><a href="/legal/privacy-policy">Privacy</a><a href="/legal/cookie-policy">Cookies</a></div>
      </div>
    </footer>
    <script is:inline>
      const menuButton = document.querySelector('.menu-button');
      const navLinks = document.querySelector('.nav-links');
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        navLinks?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>

<style is:global>
  :root{--ink:#17131f;--muted:#6f687b;--paper:#fbfaff;--panel:#fff;--line:#e8e2ef;--purple:#7c3aed;--purple-dark:#5b21b6;--purple-soft:#f1ecff;--shadow:0 24px 80px rgba(45,26,76,.12);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);line-height:1.6}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}button,input{font:inherit}[hidden]{display:none!important}.shell{width:min(1200px,calc(100% - 40px));margin-inline:auto}.skip-link{position:fixed;left:12px;top:-60px;background:var(--ink);color:white;padding:10px 14px;border-radius:8px;z-index:100}.skip-link:focus{top:12px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .site-header{height:72px;position:sticky;top:0;background:rgba(251,250,255,.88);backdrop-filter:blur(18px);border-bottom:1px solid rgba(232,226,239,.8);z-index:50}.nav{height:72px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.brand{display:block;width:176px}.brand img{width:100%;height:auto}.nav-links{display:flex;align-items:center;gap:32px;font-weight:550}.nav-links>a,.nav-popover>summary{padding:12px 0;cursor:pointer;list-style:none}.nav-popover{position:relative}.nav-popover summary::-webkit-details-marker{display:none}.nav-popover summary::after{content:'⌄';margin-left:7px;color:var(--muted)}.nav-popover>div{display:none;position:absolute;top:44px;left:50%;transform:translateX(-50%);width:310px;padding:10px;background:white;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow)}.nav-popover[open]>div{display:grid}.nav-popover>div a{padding:12px;border-radius:10px;font-weight:650}.nav-popover>div a:hover{background:var(--purple-soft)}.nav-popover small{display:block;color:var(--muted);font-weight:450;margin-top:2px}.nav-actions{justify-self:end;display:flex;align-items:center;gap:16px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 22px;border-radius:11px;background:var(--purple);color:white;font-weight:700;box-shadow:0 10px 28px rgba(124,58,237,.2);transition:.2s transform,.2s background}.button:hover{background:var(--purple-dark);transform:translateY(-1px)}.button.secondary{background:white;color:var(--ink);border:1px solid var(--line);box-shadow:none}.button.small{min-height:38px;padding:0 17px;font-size:14px}.menu-button{display:none;border:0;background:none;padding:8px}.menu-button span:not(.sr-only){display:block;width:24px;height:2px;background:var(--ink);margin:5px}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;padding:6px 11px;border:1px solid #d8ccff;background:#f7f4ff;color:var(--purple-dark);border-radius:999px;font-size:13px;font-weight:750;letter-spacing:.02em}.eyebrow::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--purple)}h1,h2,h3{line-height:1.08;letter-spacing:-.045em;margin:0}h1{font-size:clamp(46px,6vw,78px)}h2{font-size:clamp(36px,4.5vw,58px)}h3{font-size:clamp(22px,3vw,30px)}.lede{font-size:clamp(18px,2vw,22px);color:var(--muted);line-height:1.55}.section{padding:110px 0}.section-heading{max-width:700px;margin:0 auto 58px;text-align:center}.section-heading p{color:var(--muted);font-size:18px}.grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px}.card{background:var(--panel);border:1px solid var(--line);border-radius:20px;box-shadow:0 8px 32px rgba(45,26,76,.06)}
  .prose-shell{width:min(800px,calc(100% - 40px));margin-inline:auto;padding:84px 0 120px}.prose-shell header{margin-bottom:52px}.prose-shell h1{font-size:clamp(42px,6vw,68px)}.prose-shell .lede{max-width:720px}.prose{font-size:17px}.prose h2{font-size:32px;margin:52px 0 18px}.prose h3{font-size:23px;margin:36px 0 12px}.prose p,.prose li{color:#4f4859}.prose a{color:var(--purple-dark);text-decoration:underline;text-underline-offset:3px}.prose pre{padding:20px;overflow:auto;background:#17131f;color:#f7f4ff;border-radius:14px;font-size:14px}.prose code:not(pre code){background:var(--purple-soft);padding:2px 6px;border-radius:5px}.prose table{width:100%;border-collapse:collapse}.prose th,.prose td{padding:12px;text-align:left;border-bottom:1px solid var(--line)}
  footer{border-top:1px solid var(--line);background:white;padding:54px 0}.footer-grid{display:grid;grid-template-columns:2.2fr repeat(4,1fr);gap:36px}.footer-grid>div{display:flex;flex-direction:column;align-items:flex-start;gap:10px;font-size:14px}.footer-grid strong{margin-bottom:6px}.footer-grid p{max-width:320px;color:var(--muted);margin:8px 0}.footer-brand{width:150px}
  @media(max-width:850px){.site-header{height:auto}.nav{height:auto;min-height:64px;grid-template-columns:1fr auto}.brand{width:150px}.menu-button{display:block;justify-self:end}.nav-links{display:none;grid-column:1/-1;padding:12px 0 20px;align-items:stretch;flex-direction:column;gap:4px}.nav-links.open{display:flex}.nav-popover{width:100%}.nav-popover>div{position:static;transform:none;width:100%;box-shadow:none}.nav-actions{display:none}.grid-2{grid-template-columns:1fr}.section{padding:76px 0}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}}
  @media(max-width:520px){.shell,.prose-shell{width:min(100% - 28px,1200px)}.footer-grid{grid-template-columns:1fr}.footer-grid>div:first-child{grid-column:auto}h1{font-size:44px}}
</style>

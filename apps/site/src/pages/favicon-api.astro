---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const apiBase =
  process.env.INSIGHT_FAVICON_API_URL || process.env.VEMETRIC_FAVICON_API_URL || 'https://favicon.vemetric.com';
---
<BaseLayout title="Favicon API" description="Try the configurable favicon API used by Insight.info."><PageHero eyebrow="Favicon API" title="A tiny icon endpoint for cleaner analytics" description="Enter a domain to preview the favicon URL Insight.info will request. The endpoint is configurable for self-hosted deployments." /><section class="shell playground card"><form><label for="domain">Website domain</label><div><input id="domain" name="domain" value="insight.info" inputmode="url" autocomplete="url"/><button class="button" type="submit">Load favicon</button></div></form><div class="result"><img data-favicon src={`${apiBase}/insight.info?size=128`} alt="Favicon preview" width="96" height="96"/><div><small>Request URL</small><code data-url>{apiBase}/insight.info?size=128</code></div></div><p>Configure <code>INSIGHT_FAVICON_API_URL</code> to use your preferred favicon endpoint.</p></section><script is:inline define:vars={{ apiBase }}>const form=document.querySelector('form');form?.addEventListener('submit',(event)=>{event.preventDefault();const domain=new FormData(form).get('domain')?.toString().trim().replace(/^https?:\/\//,'').replace(/\/.*$/,'');if(!domain)return;const url=`${apiBase.replace(/\/$/,'')}/${encodeURIComponent(domain)}?size=128`;document.querySelector('[data-favicon]').src=url;document.querySelector('[data-favicon]').alt=`${domain} favicon preview`;document.querySelector('[data-url]').textContent=url;});</script></BaseLayout>
<style>.playground{max-width:800px;margin:0 auto 120px;padding:42px}.playground label{display:block;font-weight:800;margin-bottom:10px}.playground form>div{display:flex;gap:10px}.playground input{flex:1;min-width:0;border:1px solid var(--line);border-radius:11px;padding:12px 15px}.result{display:flex;align-items:center;gap:25px;margin:36px 0;padding:25px;background:var(--purple-soft);border-radius:14px}.result img{border-radius:18px;background:white;padding:8px}.result small,.result code{display:block}.result code{word-break:break-all}.playground>p{color:var(--muted);font-size:14px}.playground a{color:var(--purple-dark);text-decoration:underline}@media(max-width:600px){.playground form>div{display:grid}.result{align-items:flex-start;flex-direction:column}}</style>

---
import { getCollection, render } from 'astro:content';
import DocsShell from '../../components/DocsShell.astro';
export async function getStaticPaths() { return (await getCollection('docs')).map((entry) => ({ params: { slug: entry.id.replace(/\.md$/, '') }, props: { entry } })); }
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<DocsShell title={entry.data.title} description={entry.data.description} active={entry.id.replace(/\.md$/, '')}><Content /></DocsShell>

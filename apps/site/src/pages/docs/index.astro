---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const searchData = docs.map((entry) => ({ title: entry.data.title, description: entry.data.description, category: entry.data.category, url: `/docs/${entry.id.replace(/\.md$/, '')}` }));
---
<BaseLayout title="Documentation" description="Install and use Insight.info with Vemetric-compatible SDKs."><PageHero eyebrow="Documentation" title="From first event to useful answer" description="Install a compatible SDK, point it at Insight.info, then explore traffic, users, journeys and funnels." /><section class="shell docs-search"><label for="docs-query">Search documentation</label><input id="docs-query" type="search" placeholder="Try “React”, “proxy” or “funnels”" autocomplete="off"/><p data-empty hidden>No matching guides found.</p></section><section class="shell docs-grid" data-results>{docs.map((entry) => <a class="card" href={`/docs/${entry.id.replace(/\.md$/, '')}`} data-card><small>{entry.data.category}</small><h2>{entry.data.title}</h2><p>{entry.data.description}</p><span>Read guide →</span></a>)}</section><script is:inline define:vars={{ searchData }}>const input=document.querySelector('#docs-query');const cards=[...document.querySelectorAll('[data-card]')];input?.addEventListener('input',()=>{const query=input.value.trim().toLowerCase();let visible=0;cards.forEach((card,index)=>{const item=searchData[index];const match=!query||`${item.title} ${item.description} ${item.category}`.toLowerCase().includes(query);card.hidden=!match;if(match)visible++;});document.querySelector('[data-empty]').hidden=visible>0;});</script></BaseLayout>
<style>.docs-search{max-width:800px}.docs-search label{display:block;font-weight:800;margin-bottom:9px}.docs-search input{width:100%;padding:17px 20px;border:1px solid var(--line);border-radius:13px;background:white;font-size:17px;box-shadow:0 8px 30px rgba(45,26,76,.05)}.docs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:35px 0 120px}.docs-grid a{padding:26px;display:block}.docs-grid small{color:var(--purple);font-weight:800}.docs-grid h2{font-size:23px;margin:15px 0 10px}.docs-grid p{color:var(--muted);font-size:14px}.docs-grid span{color:var(--purple-dark);font-weight:700;font-size:13px}@media(max-width:900px){.docs-grid{grid-template-columns:1fr 1fr}}@media(max-width:580px){.docs-grid{grid-template-columns:1fr}}</style>

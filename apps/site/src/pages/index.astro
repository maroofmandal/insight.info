---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PUBLIC_PRICING } from '@vemetric/common/pricing';

const integrations = [
  ['HTML', '<script src="https://insight.info/insight.min.js" data-token="YOUR_PROJECT_TOKEN" data-host="https://insight.info" defer></script>'],
  ['JavaScript', "vemetric.init({ token, host: 'https://insight.info', scriptUrl: 'https://insight.info/insight.min.js' });"],
  ['React', '<VemetricScript token={token} host="https://insight.info" scriptUrl="https://insight.info/insight.min.js" />'],
  ['Astro', "<script>window.vemetric?.trackEvent('page_view')</script>"],
];

const faqs = [
  ['Is Insight.info open source?', 'Yes. The product is built from the AGPL-licensed Vemetric project. Our source and upstream attribution remain public.'],
  ['Do I need a cookie banner?', 'Insight.info is designed for privacy-conscious, first-party analytics. Your legal obligations still depend on your configuration and jurisdiction.'],
  ['Can I use the existing SDKs?', 'Yes. The Vemetric-compatible JavaScript, React and server SDKs remain supported and can be pointed at the Insight.info event hub.'],
  ['What happens when I reach my event limit?', 'We show clear usage information. Paid limits and prices use the same configuration as the billing application, so the site and product stay aligned.'],
];
const pricingTiers = JSON.stringify(PUBLIC_PRICING.tiers);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <span class="eyebrow">Open-source product analytics</span>
      <h1>See what people do. Know what to build.</h1>
      <p class="lede">Insight.info brings privacy-minded web and product analytics into one calm, focused workspace.</p>
      <div class="hero-actions">
        <a class="button" href="/signup">Start for free</a>
        <a class="button secondary" href="/insight.info?t=24hrs">View live demo</a>
      </div>
      <p class="hero-note">No credit card required · Vemetric-compatible SDKs</p>
    </div>
    <div class="hero-visual" aria-label="Animated analytics dashboard preview">
      <div class="glow"></div>
      <div class="dashboard-window card">
        <div class="window-bar"><i></i><i></i><i></i><span>insight.info · last 24 hours</span></div>
        <div class="mini-grid">
          <article><small>Visitors</small><strong>12,847</strong><em>+18.4%</em></article>
          <article><small>Events</small><strong>38,219</strong><em>+11.7%</em></article>
          <article><small>Conversion</small><strong>7.8%</strong><em>+2.1%</em></article>
        </div>
        <div class="chart-card">
          <div><strong>Activity</strong><span>24hrs</span></div>
          <svg viewBox="0 0 620 230" role="img" aria-label="Rising activity chart">
            <defs><linearGradient id="fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8b5cf6" stop-opacity=".28"/><stop offset="1" stop-color="#8b5cf6" stop-opacity="0"/></linearGradient></defs>
            <path class="area" d="M0 185 C45 164 66 177 103 148 S166 163 205 118 S276 140 320 99 S386 119 430 74 S501 91 544 46 S590 55 620 27 V230 H0Z"/>
            <path class="line" d="M0 185 C45 164 66 177 103 148 S166 163 205 118 S276 140 320 99 S386 119 430 74 S501 91 544 46 S590 55 620 27"/>
          </svg>
        </div>
        <div class="pulse-dot one"></div><div class="pulse-dot two"></div>
      </div>
    </div>
  </section>

  <section class="metrics-strip">
    <div class="shell metrics">
      <div><strong>&lt; 2 KB</strong><span>lightweight web script</span></div>
      <div><strong>Real time</strong><span>event visibility</span></div>
      <div><strong>One view</strong><span>web + product analytics</span></div>
      <div><strong>AGPL</strong><span>open-source foundation</span></div>
    </div>
  </section>

  <section class="section shell" id="product">
    <div class="section-heading"><span class="eyebrow">A clearer dashboard</span><h2>Answers without the analytics maze</h2><p>Move from traffic to behavior, people, events and funnels without stitching together five tools.</p></div>
    <div class="product-tabs" data-tabs>
      <div class="tab-list" role="tablist" aria-label="Product views">
        <button role="tab" aria-selected="true" data-tab="overview">Overview</button>
        <button role="tab" aria-selected="false" data-tab="events">Events</button>
        <button role="tab" aria-selected="false" data-tab="funnels">Funnels</button>
        <button role="tab" aria-selected="false" data-tab="people">People</button>
      </div>
      <div class="product-frame card">
        <div class="fake-sidebar"><img src="/logo.svg" alt=""/><i></i><i></i><i></i><i></i></div>
        <div class="fake-content" data-panel="overview"><header><div><small>Overview</small><h3>Good morning</h3></div><span>Last 24 hours</span></header><div class="stats"><b>8,941<small>Visitors</small></b><b>25,602<small>Events</small></b><b>4m 12s<small>Median session</small></b></div><div class="big-chart"><span></span></div></div>
        <div class="fake-content" data-panel="events" hidden><header><div><small>Behavior</small><h3>Top events</h3></div><span>Live</span></header><div class="rows"><p><b>page_view</b><span>14,288</span></p><p><b>signup_started</b><span>1,902</span></p><p><b>project_created</b><span>846</span></p><p><b>invite_sent</b><span>391</span></p></div></div>
        <div class="fake-content" data-panel="funnels" hidden><header><div><small>Conversion</small><h3>Activation funnel</h3></div><span>7 days</span></header><div class="funnel"><i style="--w:100%">Visited · 12,847</i><i style="--w:72%">Signed up · 9,249</i><i style="--w:49%">Created project · 6,295</i><i style="--w:31%">Sent first event · 3,983</i></div></div>
        <div class="fake-content" data-panel="people" hidden><header><div><small>Users</small><h3>Recent journeys</h3></div><span>Now</span></header><div class="rows"><p><b>maya@north.studio</b><span>12 events</span></p><p><b>alex@insight.info</b><span>8 events</span></p><p><b>guest_9482</b><span>5 events</span></p><p><b>sam@tiny.tools</b><span>4 events</span></p></div></div>
      </div>
    </div>
  </section>

  <section class="section feature-wrap">
    <div class="shell feature-grid">
      <div><span class="eyebrow">Web analytics</span><h2>Understand every visit at a glance.</h2><p class="lede">Traffic, sources, pages, countries and devices arrive in a fast, shareable dashboard—without the noise.</p><ul><li>Live visitor and page-view trends</li><li>Public dashboards with readable URLs</li><li>Filters that stay in the link you share</li></ul><a class="text-link" href="/docs/dashboard">Explore the dashboard →</a></div>
      <div class="feature-art traffic card"><span class="orbit a"></span><span class="orbit b"></span><div class="source">Search <b>42%</b></div><div class="source">Direct <b>31%</b></div><div class="source">Social <b>18%</b></div><div class="source">Other <b>9%</b></div></div>
    </div>
  </section>

  <section class="section">
    <div class="shell feature-grid reverse">
      <div><span class="eyebrow">Product analytics</span><h2>Follow the path from interest to action.</h2><p class="lede">Track meaningful events, identify users and see where journeys accelerate or stop.</p><ul><li>Custom events and typed properties</li><li>User profiles and complete journeys</li><li>Funnels for your highest-value actions</li></ul><a class="text-link" href="/docs/product-analytics/getting-started">Learn about product analytics →</a></div>
      <div class="feature-art journey card"><div class="person">AM</div><div class="journey-line"></div><div class="step">Viewed pricing <small>10:42</small></div><div class="step active">Started checkout <small>10:46</small></div><div class="step">Subscribed <small>10:49</small></div></div>
    </div>
  </section>

  <section class="section privacy-section">
    <div class="shell privacy-card">
      <div><span class="eyebrow">Privacy by design</span><h2>Useful insight with a smaller data footprint.</h2><p class="lede">Collect what improves your product. Avoid the surveillance machinery that does not.</p><a class="button secondary" href="/legal/privacy-policy">Read the privacy draft</a></div>
      <div class="shield" aria-hidden="true"><svg viewBox="0 0 180 210"><path d="M90 8 161 36v60c0 47-29 87-71 106C48 183 19 143 19 96V36Z"/><path d="m56 105 23 23 48-53"/></svg></div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading"><span class="eyebrow">Fits your stack</span><h2>Start measuring in minutes</h2><p>Use the compatible SDK that already matches your application, and point it at Insight.info.</p></div>
    <div class="integration card" data-integrations>
      <div class="integration-tabs" role="tablist" aria-label="Integration examples">{integrations.map(([name], index) => <button role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-integration={name}>{name}</button>)}</div>
      <div class="code-window"><div><i></i><i></i><i></i><button type="button" data-copy>Copy</button></div>{integrations.map(([name, code], index) => <pre data-code={name} hidden={index !== 0}><code>{code}</code></pre>)}</div>
    </div>
  </section>

  <section class="section pricing-section" id="pricing" data-pricing-tiers={pricingTiers}>
    <div class="shell"><div class="section-heading"><span class="eyebrow">Straightforward pricing</span><h2>Pay for the events you use</h2><p>Start free, then choose a monthly event limit. Values come from the same configuration as billing.</p></div>
      <div class="pricing-card card">
        <div><p>Monthly events</p><strong data-event-label>{PUBLIC_PRICING.tiers[0].events.toLocaleString()}</strong><input type="range" min="0" max={PUBLIC_PRICING.tiers.length - 1} value="0" step="1" aria-label="Monthly event tier" data-price-range/><div class="range-labels"><span>{PUBLIC_PRICING.tiers[0].events.toLocaleString()}</span><span>{PUBLIC_PRICING.tiers.at(-1)?.events.toLocaleString()}</span></div></div>
        <div class="price"><span>from</span><strong><sup>$</sup><i data-price>{PUBLIC_PRICING.tiers[0].monthlyPrice}</i></strong><span>/ month</span><a class="button" href="/signup">Start for free</a><small>{PUBLIC_PRICING.freeEvents.toLocaleString()} events included on the free plan</small></div>
      </div>
    </div>
  </section>

  <section class="section shell faq-section"><div class="section-heading"><span class="eyebrow">Questions, answered</span><h2>Before you add the script</h2></div><div class="faqs">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>

  <section class="final-cta"><div class="shell"><div><span class="eyebrow">Clarity starts with one event</span><h2>Turn activity into a decision.</h2><p>Set up Insight.info with the SDK you already know.</p></div><div><a class="button" href="/signup">Create your workspace</a><a class="button secondary" href="/docs/installation">View installation guide</a></div></div></section>

  <script is:inline>
    document.querySelectorAll('[data-tabs]').forEach((root) => root.querySelectorAll('[data-tab]').forEach((button) => button.addEventListener('click', () => { root.querySelectorAll('[data-tab]').forEach((item) => item.setAttribute('aria-selected', String(item === button))); root.querySelectorAll('[data-panel]').forEach((panel) => panel.hidden = panel.dataset.panel !== button.dataset.tab); })));
    const integrationRoot = document.querySelector('[data-integrations]');
    integrationRoot?.querySelectorAll('[data-integration]').forEach((button) => button.addEventListener('click', () => { integrationRoot.querySelectorAll('[data-integration]').forEach((item) => item.setAttribute('aria-selected', String(item === button))); integrationRoot.querySelectorAll('[data-code]').forEach((code) => code.hidden = code.dataset.code !== button.dataset.integration); }));
    integrationRoot?.querySelector('[data-copy]')?.addEventListener('click', async (event) => { const code = integrationRoot.querySelector('[data-code]:not([hidden])')?.textContent || ''; await navigator.clipboard.writeText(code); event.currentTarget.textContent = 'Copied'; setTimeout(() => event.currentTarget.textContent = 'Copy', 1200); });
    const range = document.querySelector('[data-price-range]');
    const tiers = JSON.parse(document.querySelector('[data-pricing-tiers]')?.dataset.pricingTiers || '[]');
    const renderPrice = () => { const tier = tiers[Number(range?.value || 0)]; document.querySelector('[data-event-label]').textContent = Number(tier.events).toLocaleString(); document.querySelector('[data-price]').textContent = tier.monthlyPrice; };
    range?.addEventListener('input', renderPrice);
  </script>
</BaseLayout>

<style>
  .hero{min-height:780px;display:grid;grid-template-columns:.9fr 1.1fr;align-items:center;gap:66px;padding-top:70px;padding-bottom:90px}.hero-copy h1{margin:22px 0}.hero-copy .lede{max-width:620px}.hero-actions{display:flex;gap:12px;margin-top:32px}.hero-note{font-size:13px;color:var(--muted);margin-top:17px}.hero-visual{position:relative;min-width:0}.glow{position:absolute;inset:8% -4% -8% 2%;background:radial-gradient(circle,#d9c9ff 0,rgba(217,201,255,.35) 38%,transparent 72%);filter:blur(10px)}.dashboard-window{position:relative;padding:14px;background:rgba(255,255,255,.88);transform:perspective(1200px) rotateY(-6deg) rotateX(2deg);animation:float 6s ease-in-out infinite}.window-bar{height:38px;display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px}.window-bar i,.code-window>div i{width:8px;height:8px;border-radius:50%;background:#ded7e7}.window-bar span{margin-left:auto}.mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.mini-grid article{padding:15px;background:#faf8fe;border:1px solid var(--line);border-radius:12px}.mini-grid small,.mini-grid strong,.mini-grid em{display:block}.mini-grid strong{font-size:21px}.mini-grid em{font-size:11px;color:#16a34a;font-style:normal}.chart-card{margin-top:10px;padding:17px;border:1px solid var(--line);border-radius:13px}.chart-card>div{display:flex;justify-content:space-between}.chart-card span{font-size:12px;color:var(--muted)}.chart-card svg{width:100%;margin-top:8px;overflow:visible}.area{fill:url(#fill)}.line{fill:none;stroke:#7c3aed;stroke-width:4;stroke-linecap:round;stroke-dasharray:800;animation:draw 2.2s ease-out both}.pulse-dot{position:absolute;width:10px;height:10px;border-radius:50%;background:#7c3aed;box-shadow:0 0 0 0 rgba(124,58,237,.4);animation:pulse 2s infinite}.pulse-dot.one{left:30%;top:58%}.pulse-dot.two{right:11%;top:32%;animation-delay:.8s}.metrics-strip{border-block:1px solid var(--line);background:white}.metrics{display:grid;grid-template-columns:repeat(4,1fr);padding:28px 0}.metrics div{display:flex;flex-direction:column;align-items:center;border-right:1px solid var(--line)}.metrics div:last-child{border:0}.metrics strong{font-size:20px}.metrics span{font-size:13px;color:var(--muted)}
  .product-tabs{max-width:1050px;margin:auto}.tab-list{display:flex;justify-content:center;gap:8px;margin-bottom:20px}.tab-list button,.integration-tabs button{border:0;background:transparent;color:var(--muted);padding:10px 18px;border-radius:9px;cursor:pointer;font-weight:650}.tab-list button[aria-selected=true],.integration-tabs button[aria-selected=true]{background:var(--purple-soft);color:var(--purple-dark)}.product-frame{min-height:520px;display:grid;grid-template-columns:72px 1fr;overflow:hidden;background:#f8f6fc}.fake-sidebar{padding:22px 18px;background:#211a2e;display:flex;flex-direction:column;align-items:center;gap:22px}.fake-sidebar img{width:32px}.fake-sidebar i{width:25px;height:6px;border-radius:5px;background:#4a405b}.fake-content{background:white;margin:22px 22px 22px 0;border-radius:16px;padding:30px}.fake-content header{display:flex;justify-content:space-between;align-items:flex-start}.fake-content header small{color:var(--purple);font-weight:700}.fake-content header span{padding:8px 12px;background:#f7f4fb;border-radius:8px;font-size:12px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:30px 0}.stats b{padding:20px;border:1px solid var(--line);border-radius:12px;font-size:25px}.stats small{display:block;color:var(--muted);font-weight:500;font-size:12px}.big-chart{height:220px;border:1px solid var(--line);border-radius:12px;background:repeating-linear-gradient(0deg,transparent,transparent 43px,#f0ecf4 44px)}.big-chart span{display:block;height:100%;background:linear-gradient(160deg,transparent 49%,rgba(124,58,237,.16) 50%,rgba(124,58,237,.05) 68%,transparent 69%);clip-path:polygon(0 82%,11% 62%,22% 68%,34% 39%,45% 53%,57% 28%,68% 35%,80% 10%,91% 18%,100% 0,100% 100%,0 100%)}.rows{margin-top:28px}.rows p{display:flex;justify-content:space-between;margin:0;padding:18px;border-bottom:1px solid var(--line)}.rows span{color:var(--muted)}.funnel{display:grid;gap:12px;margin-top:40px}.funnel i{width:var(--w);min-width:42%;padding:15px;background:linear-gradient(90deg,#6d28d9,#a78bfa);color:white;border-radius:8px;font-style:normal}
  .feature-wrap{background:white;border-block:1px solid var(--line)}.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center}.feature-grid.reverse>div:first-child{order:2}.feature-grid h2{margin:20px 0}.feature-grid ul{padding:0;list-style:none;margin:28px 0}.feature-grid li{padding:9px 0 9px 30px;position:relative}.feature-grid li::before{content:'✓';position:absolute;left:0;color:var(--purple);font-weight:800}.text-link{color:var(--purple-dark);font-weight:750}.feature-art{min-height:480px;position:relative;overflow:hidden;padding:48px}.traffic{display:flex;flex-direction:column;justify-content:center;gap:14px;background:radial-gradient(circle at 50% 50%,#fff 0,#faf7ff 55%,#efe9ff 100%)}.source{position:relative;z-index:2;display:flex;justify-content:space-between;padding:18px 20px;background:white;border:1px solid var(--line);border-radius:12px;box-shadow:0 10px 35px rgba(45,26,76,.07)}.source:nth-of-type(2){margin-left:7%}.source:nth-of-type(3){margin-left:14%}.source:nth-of-type(4){margin-left:21%}.orbit{position:absolute;border:1px solid #dcd0ff;border-radius:50%}.orbit.a{inset:7% 2%}.orbit.b{inset:19% 14%}.journey{display:grid;align-content:center;gap:18px;background:#211a2e;color:white}.person{width:60px;height:60px;border-radius:50%;display:grid;place-items:center;background:#7c3aed;font-weight:800}.journey-line{position:absolute;left:77px;top:180px;bottom:80px;width:2px;background:#574a6d}.step{position:relative;margin-left:70px;padding:18px 20px;border:1px solid #4a405b;background:#2d253b;border-radius:12px}.step::before{content:'';position:absolute;left:-45px;top:26px;width:12px;height:12px;border-radius:50%;background:#766a89;border:6px solid #211a2e}.step.active{border-color:#a78bfa}.step.active::before{background:#a78bfa}.step small{float:right;color:#afa6bd}.privacy-section{padding-top:0}.privacy-card{border-radius:28px;background:linear-gradient(130deg,#eee8ff,#f9f7ff);padding:70px;display:grid;grid-template-columns:1.25fr .75fr;align-items:center;overflow:hidden}.privacy-card h2{margin:20px 0}.shield{display:grid;place-items:center}.shield svg{width:210px;filter:drop-shadow(0 30px 40px rgba(91,33,182,.22))}.shield path:first-child{fill:#7c3aed;stroke:#5b21b6;stroke-width:4}.shield path:last-child{fill:none;stroke:white;stroke-width:12;stroke-linecap:round;stroke-linejoin:round}
  .integration{max-width:900px;margin:auto;overflow:hidden}.integration-tabs{display:flex;padding:12px;border-bottom:1px solid var(--line);gap:5px}.code-window{background:#17131f;color:#eae5f3;min-height:190px;padding:18px 24px}.code-window>div{display:flex;align-items:center;gap:7px}.code-window>div i{background:#554b63}.code-window button{margin-left:auto;border:1px solid #574d64;background:#292132;color:white;border-radius:7px;padding:5px 10px;cursor:pointer}.code-window pre{white-space:pre-wrap;margin:34px 0 0;font-size:14px}.pricing-section{background:white;border-block:1px solid var(--line)}.pricing-card{max-width:900px;margin:auto;padding:50px;display:grid;grid-template-columns:1.4fr .6fr;gap:70px;align-items:center}.pricing-card p{color:var(--muted);margin:0}.pricing-card>div>strong{display:block;font-size:35px;margin:3px 0 28px}.pricing-card input{width:100%;accent-color:var(--purple)}.range-labels{display:flex;justify-content:space-between;font-size:12px;color:var(--muted)}.price{text-align:center;border-left:1px solid var(--line);padding-left:50px}.price>span{display:block;color:var(--muted);font-size:13px}.price>strong{display:block!important;font-size:54px!important;margin:0!important}.price sup{font-size:20px}.price i{font-style:normal}.price .button{margin:18px 0 8px;width:100%}.price small{display:block;color:var(--muted)}.faqs{max-width:800px;margin:auto;border-top:1px solid var(--line)}.faqs details{border-bottom:1px solid var(--line);padding:20px 4px}.faqs summary{cursor:pointer;font-weight:750;font-size:18px;list-style:none;display:flex;justify-content:space-between}.faqs summary::after{content:'+';font-size:25px;color:var(--purple)}.faqs details[open] summary::after{content:'−'}.faqs p{color:var(--muted);max-width:700px}.final-cta{padding:90px 0;background:#211a2e;color:white}.final-cta>.shell{display:flex;justify-content:space-between;align-items:center;gap:30px}.final-cta h2{margin:18px 0 10px}.final-cta p{color:#c5bdcf}.final-cta>div>div:last-child{display:flex;gap:12px}.final-cta .button.secondary{background:transparent;color:white;border-color:#5b5068}
  @keyframes float{50%{transform:perspective(1200px) rotateY(-4deg) rotateX(1deg) translateY(-10px)}}@keyframes draw{from{stroke-dashoffset:800}to{stroke-dashoffset:0}}@keyframes pulse{70%{box-shadow:0 0 0 14px rgba(124,58,237,0)}}
  @media(max-width:900px){.hero{grid-template-columns:1fr;padding-top:70px}.hero-copy{text-align:center}.hero-copy .lede{margin-inline:auto}.hero-actions{justify-content:center}.hero-visual{max-width:700px;margin:auto}.metrics{grid-template-columns:1fr 1fr;gap:24px}.metrics div:nth-child(2){border:0}.feature-grid{grid-template-columns:1fr;gap:45px}.feature-grid.reverse>div:first-child{order:0}.privacy-card{grid-template-columns:1fr;padding:50px}.shield{margin-top:40px}.pricing-card{grid-template-columns:1fr}.price{border-left:0;border-top:1px solid var(--line);padding:35px 0 0}.final-cta>.shell{display:block;text-align:center}.final-cta>div>div:last-child{justify-content:center;margin-top:30px}}
  @media(max-width:580px){.hero{min-height:auto;padding-top:52px}.hero-actions{flex-direction:column}.dashboard-window{transform:none;padding:9px}.mini-grid{grid-template-columns:1fr 1fr}.mini-grid article:last-child{display:none}.metrics{grid-template-columns:1fr}.metrics div{border:0;border-bottom:1px solid var(--line);padding-bottom:18px}.product-frame{grid-template-columns:48px 1fr;min-height:420px}.fake-sidebar{padding:18px 10px}.fake-content{margin:10px 10px 10px 0;padding:18px}.stats{grid-template-columns:1fr 1fr}.stats b:last-child{display:none}.tab-list{justify-content:flex-start;overflow-x:auto}.feature-art{min-height:400px;padding:25px}.privacy-card{padding:36px 25px}.integration-tabs{overflow-x:auto}.pricing-card{padding:30px 22px}.final-cta>div>div:last-child{flex-direction:column}}
  @media(prefers-reduced-motion:reduce){.dashboard-window,.line,.pulse-dot{animation:none}}
</style>

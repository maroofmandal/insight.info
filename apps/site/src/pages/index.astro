---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PUBLIC_PRICING } from '@vemetric/common/pricing';

const productViews = [
  ['dashboard','Web analytics','/images/reference/hero-dashboard.webp?v=insight-20260822'],
  ['users','User journeys','/images/reference/hero-users.webp?v=insight-20260822'],
  ['funnels','Funnels','/images/reference/hero-funnels.webp?v=insight-20260822'],
  ['events','Event streams','/images/reference/hero-events.webp?v=insight-20260822'],
];
const integrations = [
  ['HTML','<script src="https://insight.info/insight.min.js" data-token="YOUR_PROJECT_TOKEN" defer></script>'],
  ['JavaScript',"vemetric.init({ token, host: 'https://insight.info' });"],
  ['React','<VemetricScript token={token} host="https://insight.info" />'],
  ['Astro',"<script>window.vemetric?.trackEvent('page_view')</script>"],
];
const customers = ['ansehn','caperity','phare','supastarter','astrolescent'];
const heroEvents = [
  ['CreateFunnel','10:42:41','event'],
  ['/funnels','10:39:38','page'],
  ['/dashboard','10:23:01','page'],
  ['Purchase','08:47:57','event'],
  ['/pricing','08:46:04','page'],
  ['/blog/privacy-first-analytics','08:45:32','page'],
];
const faqs = [
  ['Can I start for free?','Yes. Every workspace includes a generous free monthly event allowance, with no credit card required.'],
  ['Can I track both websites and products?','Yes. Insight.info brings acquisition, page views, identified users, custom events, journeys and funnels into one place.'],
  ['Do I need a cookie banner?','Insight.info is designed for privacy-conscious first-party analytics. Your obligations still depend on your setup and jurisdiction.'],
  ['Which integrations are supported?','Use the HTML script or compatible JavaScript, React, Astro and server SDKs with the Insight.info endpoint.'],
];
const pricingTiers = JSON.stringify(PUBLIC_PRICING.tiers);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-layout">
      <div class="hero-copy">
        <a class="announcement" href="/docs/api/getting-started"><span>API</span> The Insight.info API is live <b>›</b></a>
        <h1>How do your users find you?<br/>And how do you <em>make them stay?</em></h1>
        <p class="lede">Insight.info lets you see how users arrive, when they convert, and how they use your product. All in one place. Without the complexity.</p>
        <div class="hero-actions"><a class="button" href="/signup">Start tracking <span aria-hidden="true">ϟ</span></a><a class="button secondary" href="/insight.info?t=24hrs">View Live Demo <span aria-hidden="true">⌁</span></a></div>
        <div class="hero-customers" aria-label="Customer logos"><p>Trusted by organizations around the globe</p><div class="logo-marquee"><div>{[...customers,...customers].map((name)=><img src={`/images/customers/${name}.svg`} alt={`${name} logo`} loading="eager"/>)}</div></div></div>
      </div>
      <div class="journey-panel" aria-label="Interactive example user journey">
        <div class="profile-card">
          <img src="/images/reference/dominik.png" alt="Dominik" width="56" height="56"/>
          <div class="profile-name"><strong>Dominik <i aria-label="online"></i></strong><span>🇦🇹 Austria</span></div>
          <dl><div><dt>◉</dt><dd><strong>Chrome</strong> 147.0.0</dd></div><div><dt>▣</dt><dd><strong>macOS</strong> 10.15.7</dd></div><div><dt>▰</dt><dd><strong>Desktop</strong></dd></div></dl>
          <p><span>◉</span><strong>First Seen</strong> 14.05.2025</p>
        </div>
        <div class="event-scroll"><div class="event-list">{heroEvents.map(([name,time,type],index)=><article class="event-card" style={`--delay:${index*90}ms`}><button type="button" aria-expanded="false" data-hero-event><span class:list={['event-icon',type]}>{type==='event'?'ϟ':'◉'}</span><strong>{name}</strong><span class="event-chevron">⌄</span></button><div class="event-details"><div><span>Date</span><time datetime={`2025-05-14T${time}`}>{time}</time></div><div class="event-meta"><span>◉ <strong>Chrome</strong> 147.0.0</span><span>▣ <strong>macOS</strong> 10.15.7</span><span>▰ <strong>Desktop</strong></span></div></div></article>)}</div></div>
        <div class="source-pill"><img src="/images/reference/google.png" alt="Google" width="20" height="20"/> Google</div>
      </div>
    </div>
  </section>

  <section class="section shell"><div class="section-heading"><span class="eyebrow">One simple analytics platform</span><h2>Everything you need to understand your users</h2><p>Go from a high-level overview to an individual user journey without losing context.</p></div>
    <div class="product-tabs" data-product-tabs><div class="product-tab-list" role="tablist" aria-label="Analytics views">{productViews.map(([id,label],index)=><button role="tab" aria-selected={index===0?'true':'false'} data-product-tab={id}>{label}</button>)}</div><div class="product-screen card">{productViews.map(([id,label,image],index)=><img data-product-panel={id} src={image} alt={`${label} screen in Insight.info`} hidden={index!==0} loading={index===0?'eager':'lazy'}/>)}</div></div>
  </section>

  <section class="section feature-section"><div class="shell feature-grid"><div><span class="feature-icon">◉</span><h2>Web analytics without the noise</h2><p class="lede">See visitors, page views, traffic sources and locations in a dashboard that makes the next step obvious.</p><ul><li>Privacy-conscious and cookie-free</li><li>Fast, focused reports</li><li>Public dashboards with clean URLs</li></ul><a class="button secondary" href="/docs/dashboard">Explore web analytics</a></div><div class="image-stack"><img src="/images/reference/top-pages.webp" alt="Top pages analytics card"/><img src="/images/reference/top-countries.webp" alt="Top countries analytics card"/><img src="/images/reference/top-referrers.webp" alt="Top referrers analytics card"/></div></div></section>

  <section class="section"><div class="shell feature-grid reverse"><div><span class="feature-icon">◎</span><h2>See the whole user journey</h2><p class="lede">Identify users, understand the paths they take and discover the moments that create activation or friction.</p><ul><li>Complete event timelines</li><li>Useful user properties</li><li>Activity and retention patterns</li></ul><a class="button secondary" href="/docs/product-analytics/user-journeys">Explore user journeys</a></div><div class="journey-art card"><img src="/images/reference/user-journey.webp" alt="User journey event timeline"/><img src="/images/reference/user-data.webp" alt="User analytics details"/><img src="/images/reference/activity-heatmap.webp" alt="User activity heatmap"/></div></div></section>

  <section class="section feature-section"><div class="shell feature-grid"><div><span class="feature-icon">▽</span><h2>Build funnels that answer real questions</h2><p class="lede">Measure conversion for the actions that matter, compare steps and find where users leave.</p><ul><li>Flexible event-based steps</li><li>Clear conversion rates</li><li>Fast funnel creation</li></ul><a class="button secondary" href="/docs/product-analytics/funnels">Explore funnels</a></div><div class="single-art card"><img src="/images/reference/funnels.webp" alt="Insight.info conversion funnel" loading="lazy"/></div></div></section>

  <section class="section"><div class="shell feature-grid reverse"><div><span class="feature-icon">◇</span><h2>Watch events as they happen</h2><p class="lede">Use the live event stream to validate tracking, investigate behavior and understand your product in real time.</p><ul><li>Live custom events</li><li>Event properties at a glance</li><li>Web and product data together</li></ul><a class="button secondary" href="/docs/product-analytics/tracking-custom-events">Explore event tracking</a></div><div class="single-art card"><img src="/images/reference/event-streams.webp" alt="Live Insight.info event stream" loading="lazy"/></div></div></section>

  <section class="privacy-section section" id="privacy"><div class="shell"><div class="section-heading"><span class="eyebrow">Privacy-first analytics</span><h2>Powerful insights. Smaller data footprint.</h2><p>Collect the product signals you need without building an advertising profile of every visitor.</p></div><div class="privacy-grid"><div class="privacy-copy card"><b>✓</b><h3>Built for privacy</h3><p>No cross-site tracking and no invasive visitor profiling. You control what enters your analytics.</p><a href="/legal/privacy-policy">Read our privacy policy →</a></div><div class="map-card card"><img src="/images/reference/world-map.svg" alt="World map showing privacy-conscious analytics coverage" loading="lazy"/><span class="map-pulse p1"></span><span class="map-pulse p2"></span><span class="map-pulse p3"></span></div></div></div></section>

  <section class="founder section"><div class="shell founder-card"><img src="/images/founder-maroof.png" alt="Maroof, Founder of Insight" width="398" height="398" loading="lazy"/><div><blockquote>“We built Insight.info to turn complicated analytics into clear answers teams can act on. Understanding your users should feel simple.”</blockquote><strong>Maroof</strong><span>Founder, Insight</span><img class="founder-logo" src="/logo-lockup.svg" alt="Insight.info"/></div></div></section>

  <section class="section install"><div class="shell"><div class="section-heading"><span class="eyebrow">Simple integration</span><h2>Start tracking in minutes</h2><p>Add one lightweight snippet or use the SDK that fits your application.</p></div><div class="integration card" data-integrations><div class="integration-tabs" role="tablist" aria-label="Installation examples">{integrations.map(([name],index)=><button role="tab" aria-selected={index===0?'true':'false'} data-integration={name}>{name}</button>)}</div><div class="code-window"><div><i></i><i></i><i></i><button type="button" data-copy>Copy</button></div>{integrations.map(([name,code],index)=><pre data-code={name} hidden={index!==0}><code>{code}</code></pre>)}</div></div></div></section>

  <section class="section pricing-home" data-pricing-tiers={pricingTiers}><div class="shell"><div class="section-heading"><span class="eyebrow">Simple pricing</span><h2>Start free. Scale when you grow.</h2><p>Choose the event limit that fits your product. Get two months free with yearly billing.</p><div class="period-toggle" role="group" aria-label="Billing period"><button class="active" data-home-period="monthly" aria-pressed="true">Monthly</button><button data-home-period="yearly" aria-pressed="false">Yearly <small>2 months free</small></button></div></div><div class="pricing-card card"><div><p>Monthly events</p><strong data-event-label>{PUBLIC_PRICING.tiers[0].events.toLocaleString()}</strong><input type="range" min="0" max={PUBLIC_PRICING.tiers.length-1} value="0" step="1" aria-label="Monthly event tier" data-price-range/></div><div class="price"><strong><sup>$</sup><i data-price>{PUBLIC_PRICING.tiers[0].monthlyPrice}</i></strong><span data-price-period>/month</span><a class="button" href="/signup">Start for free</a></div></div></div></section>

  <section class="section faq-section shell"><div class="section-heading"><span class="eyebrow">Frequently asked questions</span><h2>Everything you need to know</h2></div><div class="faqs">{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  <section class="final-cta"><div class="shell"><h2>Start understanding your users today</h2><p>Set up Insight.info in minutes. No credit card required.</p><div><a class="button" href="/signup">Start tracking for free</a><a class="button secondary" href="/insight.info?t=24hrs">View live demo</a></div></div></section>

  <script is:inline>
    document.querySelectorAll('[data-hero-event]').forEach((button)=>button.addEventListener('click',()=>{const expanded=button.getAttribute('aria-expanded')==='true';document.querySelectorAll('[data-hero-event]').forEach((item)=>item.setAttribute('aria-expanded','false'));button.setAttribute('aria-expanded',String(!expanded));button.closest('.event-card')?.scrollIntoView({block:'nearest',behavior:'smooth'})}));
    document.querySelectorAll('[data-product-tabs]').forEach((root)=>root.querySelectorAll('[data-product-tab]').forEach((button)=>button.addEventListener('click',()=>{root.querySelectorAll('[data-product-tab]').forEach((item)=>item.setAttribute('aria-selected',String(item===button)));root.querySelectorAll('[data-product-panel]').forEach((panel)=>panel.hidden=panel.dataset.productPanel!==button.dataset.productTab)})));
    const integrationRoot=document.querySelector('[data-integrations]');integrationRoot?.querySelectorAll('[data-integration]').forEach((button)=>button.addEventListener('click',()=>{integrationRoot.querySelectorAll('[data-integration]').forEach((item)=>item.setAttribute('aria-selected',String(item===button)));integrationRoot.querySelectorAll('[data-code]').forEach((code)=>code.hidden=code.dataset.code!==button.dataset.integration)}));integrationRoot?.querySelector('[data-copy]')?.addEventListener('click',async(event)=>{const code=integrationRoot.querySelector('[data-code]:not([hidden])')?.textContent||'';await navigator.clipboard.writeText(code);event.currentTarget.textContent='Copied';setTimeout(()=>event.currentTarget.textContent='Copy',1200)});
    const pricingRoot=document.querySelector('[data-pricing-tiers]');const tiers=JSON.parse(pricingRoot?.dataset.pricingTiers||'[]');const range=pricingRoot?.querySelector('[data-price-range]');let period='monthly';const renderPrice=()=>{const tier=tiers[Number(range?.value||0)];if(!tier)return;pricingRoot.querySelector('[data-event-label]').textContent=Number(tier.events).toLocaleString();pricingRoot.querySelector('[data-price]').textContent=period==='yearly'?tier.monthlyPrice*10:tier.monthlyPrice;pricingRoot.querySelector('[data-price-period]').textContent=period==='yearly'?'/year':'/month'};range?.addEventListener('input',renderPrice);pricingRoot?.querySelectorAll('[data-home-period]').forEach((button)=>button.addEventListener('click',()=>{period=button.dataset.homePeriod;pricingRoot.querySelectorAll('[data-home-period]').forEach((item)=>{const active=item===button;item.classList.toggle('active',active);item.setAttribute('aria-pressed',String(active))});renderPrice()}));
    const revealObserver=new IntersectionObserver((entries)=>entries.forEach((entry)=>{if(entry.isIntersecting){entry.target.classList.add('revealed');revealObserver.unobserve(entry.target)}}),{threshold:.15});document.querySelectorAll('.feature-grid,.product-tabs,.privacy-grid,.founder-card,.integration,.pricing-card,.faqs').forEach((item)=>{item.classList.add('reveal');revealObserver.observe(item)});
  </script>
</BaseLayout>

<style>
.hero{padding:0}.hero-layout{min-height:630px;display:grid;grid-template-columns:1.25fr .85fr;gap:28px;align-items:center;padding-top:48px}.hero-copy{min-width:0;padding:25px 0}.announcement{display:inline-flex;align-items:center;gap:9px;padding:5px 11px;border:1px solid #bcebc9;border-radius:999px;color:#2d7850;font-size:14px;background:#ecfff2}.announcement span{padding-right:9px;border-right:1px solid #bcebc9;font-size:11px;font-weight:850}.hero h1{max-width:700px;margin:27px 0 22px;font-size:clamp(43px,4.1vw,60px);letter-spacing:-.045em}.hero h1 em{font-style:normal;color:var(--purple)}.hero-copy>.lede{max-width:680px;margin:0;font-size:21px}.hero-actions{display:flex;gap:22px;margin-top:30px}.hero-actions .button{font-size:17px}.hero-actions span{font-size:21px}.hero-customers{margin-top:48px;overflow:hidden}.hero-customers>p{margin:0;text-transform:uppercase;color:var(--muted);font-size:13px;font-weight:750}.logo-marquee{overflow:hidden;mask-image:linear-gradient(90deg,#000 84%,transparent)}.logo-marquee>div{width:max-content;display:flex;align-items:center;gap:55px;padding:22px 0 2px;animation:marquee 28s linear infinite}.logo-marquee img{width:145px;max-height:38px;filter:grayscale(1);opacity:.58}.journey-panel{position:relative;height:550px;min-width:500px;align-self:start;padding:24px 28px 0;background:#f7f2ff;border:2px solid rgba(255,255,255,.9);border-radius:17px;overflow:hidden;box-shadow:inset 0 0 60px rgba(129,85,231,.04);animation:journey-enter .75s ease-out both}.profile-card{position:relative;display:grid;grid-template-columns:56px 1fr 1.25fr;gap:12px;align-items:center;padding:11px;background:#fff;border:1px solid rgba(208,202,220,.8);border-radius:13px;box-shadow:0 2px 8px rgba(38,24,69,.08);z-index:2}.profile-card>img{border-radius:10px}.profile-name strong,.profile-name span{display:block}.profile-name i{display:inline-block;width:8px;height:8px;border-radius:50%;background:#22c55e}.profile-name span{color:var(--muted)}.profile-card dl{margin:0;display:grid;gap:3px;font-size:13px}.profile-card dl div{display:grid;grid-template-columns:20px 1fr}.profile-card dt,.profile-card dd{margin:0}.profile-card dd{color:var(--muted)}.profile-card dd strong{color:var(--ink)}.profile-card>p{grid-column:1/-1;margin:0;display:flex;gap:8px;font-size:13px;color:var(--muted)}.profile-card>p strong{color:var(--ink)}.event-scroll{height:405px;margin-top:14px;overflow-y:auto;scrollbar-width:none}.event-scroll::-webkit-scrollbar{display:none}.event-list{display:grid;padding-bottom:78px}.event-card{background:#fff;border:1px solid rgba(208,202,220,.8);border-radius:11px;overflow:hidden;box-shadow:0 2px 7px rgba(38,24,69,.06);animation:event-enter .7s ease-out var(--delay) both}.event-card+article{margin-top:-1px}.event-card button{width:100%;min-height:58px;display:flex;align-items:center;gap:11px;padding:10px;border:0;background:#fff;color:var(--ink);cursor:pointer;text-align:left}.event-card button:hover,.event-card button:focus-visible{background:#faf9fc;outline:none}.event-card button>strong{font-size:15px;font-weight:600}.event-icon{width:38px;height:38px;display:grid;place-items:center;border:1px solid #ddd1ff;border-radius:10px;background:#fff;color:#303543;font-size:18px;box-shadow:0 1px 5px rgba(62,33,118,.08)}.event-chevron{margin-left:auto;color:var(--muted);transition:transform .25s}.event-card button[aria-expanded=true] .event-chevron{transform:rotate(180deg)}.event-details{display:grid;grid-template-rows:0fr;transition:grid-template-rows .32s ease}.event-details>div{overflow:hidden}.event-card button[aria-expanded=true]+.event-details{grid-template-rows:1fr}.event-details>div:first-child{display:flex;justify-content:space-between;padding:0 16px;border-top:1px dashed var(--line);line-height:0;opacity:0;transition:.25s}.event-card button[aria-expanded=true]+.event-details>div:first-child{padding-block:16px;line-height:1.4;opacity:1}.event-details time{font-weight:650}.event-meta{display:flex!important;justify-content:space-between!important;gap:10px;padding:10px 14px!important;border-top:1px solid var(--line);background:#fafafa;color:var(--muted);font-size:11px;line-height:1.4!important;opacity:1!important}.event-meta strong{color:var(--ink)}.source-pill{position:absolute;bottom:-5px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:6px;padding:8px 14px;background:#fff;border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);font-size:13px}
.section-heading h2{margin:18px 0}.product-tabs{max-width:1080px;margin:auto}.product-tab-list{display:flex;justify-content:center;gap:6px;margin-bottom:24px}.product-tab-list button,.integration-tabs button{border:0;background:transparent;padding:12px 20px;border-radius:9px;color:var(--muted);font-weight:700;cursor:pointer}.product-tab-list button[aria-selected=true],.integration-tabs button[aria-selected=true]{background:var(--purple-soft);color:var(--purple)}.product-screen{padding:18px;background:#f8f7fb;min-height:560px;display:grid;place-items:center;overflow:hidden}.product-screen img{width:100%;border-radius:12px;animation:panel-in .35s ease-out}
.feature-section{background:#faf9fd;border-block:1px solid var(--line)}.feature-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:90px;align-items:center}.feature-grid.reverse>div:first-child{order:2}.feature-grid h2{margin:18px 0}.feature-grid ul{list-style:none;padding:0;margin:28px 0}.feature-grid li{padding:8px 0 8px 28px;position:relative}.feature-grid li::before{content:'✓';position:absolute;left:0;color:var(--purple);font-weight:900}.feature-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:12px;background:var(--purple-soft);color:var(--purple);font-size:24px}.image-stack{position:relative;min-height:560px}.image-stack img{position:absolute;width:74%;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}.image-stack img:nth-child(1){top:0;left:0}.image-stack img:nth-child(2){top:30%;right:0}.image-stack img:nth-child(3){bottom:0;left:8%}.journey-art,.single-art{padding:24px;background:#f6f2ff;overflow:hidden}.journey-art{display:grid;gap:15px}.journey-art img{width:100%;border-radius:10px;box-shadow:0 8px 24px rgba(44,25,80,.1)}.single-art img{width:100%;border-radius:10px}
.privacy-section{background:linear-gradient(180deg,#fff,#f6f2ff)}.privacy-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:25px}.privacy-copy{padding:48px}.privacy-copy>b{display:grid;place-items:center;width:55px;height:55px;border-radius:50%;background:var(--purple);color:#fff;font-size:25px}.privacy-copy h3{margin:26px 0 12px}.privacy-copy p{color:var(--muted)}.privacy-copy a{color:var(--purple);font-weight:750}.map-card{position:relative;padding:28px;display:grid;place-items:center;overflow:hidden}.map-card img{opacity:.72}.map-card .p1{left:30%;top:31%}.map-card .p2{left:51%;top:45%;animation-delay:.5s}.map-card .p3{right:19%;top:38%;animation-delay:1s}
.founder{border-top:1px solid var(--line)}.founder-card{max-width:980px;display:grid;grid-template-columns:240px 1fr;gap:62px;align-items:center}.founder-card>img{width:240px;height:240px;object-fit:cover;border-radius:50%;border:3px solid var(--purple)}.founder blockquote{margin:0 0 24px;font-size:clamp(21px,2.5vw,30px);line-height:1.45}.founder strong,.founder span{display:block}.founder strong{font-size:20px}.founder span{color:var(--muted)}.founder-logo{width:145px;margin-top:20px}.install{background:#faf9fd;border-block:1px solid var(--line)}.integration{max-width:900px;margin:auto;overflow:hidden}.integration-tabs{display:flex;padding:12px;border-bottom:1px solid var(--line)}.code-window{background:#292a3f;color:#f4f0ff;min-height:200px;padding:18px 24px}.code-window>div{display:flex;gap:7px}.code-window i{width:9px;height:9px;border-radius:50%;background:#6c6e83}.code-window button{margin-left:auto;background:transparent;border:1px solid #696b80;border-radius:7px;color:#fff;padding:5px 10px;cursor:pointer}.code-window pre{white-space:pre-wrap;margin-top:38px}
.pricing-home{background:#fff}.period-toggle{display:inline-flex;padding:4px;background:var(--purple-soft);border:1px solid #ddd2ff;border-radius:999px}.period-toggle button{border:0;background:transparent;padding:9px 15px;border-radius:999px;color:var(--muted);font-weight:750;cursor:pointer}.period-toggle button.active{background:#fff;color:var(--purple);box-shadow:0 2px 9px rgba(68,35,124,.12)}.period-toggle small{color:#15803d}.pricing-card{max-width:860px;margin:auto;padding:48px;display:grid;grid-template-columns:1.4fr .6fr;gap:65px;align-items:center}.pricing-card p{color:var(--muted);margin:0}.pricing-card>div>strong{display:block;font-size:34px;margin:5px 0 24px}.pricing-card input{width:100%;accent-color:var(--purple)}.price{text-align:center;border-left:1px solid var(--line);padding-left:45px}.price>strong{font-size:54px!important;margin:0!important}.price sup{font-size:20px}.price i{font-style:normal}.price>span{display:block;color:var(--muted)}.price .button{margin-top:18px;width:100%}.faqs{max-width:780px;margin:auto;border-top:1px solid var(--line)}.faqs details{padding:21px 4px;border-bottom:1px solid var(--line)}.faqs summary{list-style:none;cursor:pointer;font-size:18px;font-weight:750;display:flex;justify-content:space-between}.faqs summary::after{content:'+';font-size:25px;color:var(--purple)}.faqs details[open] summary::after{content:'−'}.faqs p{color:var(--muted);max-width:680px}.final-cta{text-align:center;padding:95px 0;background:linear-gradient(140deg,#6d2ee8,#9a68ff);color:#fff}.final-cta h2{font-size:clamp(38px,5vw,60px)}.final-cta p{font-size:20px;opacity:.9}.final-cta>div>div{display:flex;justify-content:center;gap:12px;margin-top:26px}.final-cta .button{background:#fff;color:var(--purple);box-shadow:none}.final-cta .button.secondary{background:transparent;color:#fff;border-color:rgba(255,255,255,.65)}
